# Copy to .env and adjust. All optional.

# Host port the page is served on (http://<host>:8090).
SPEEDDIAL_PORT=8090

# Time zone of the container (the clock itself uses your browser's time).
TZ=America/Winnipeg

# Set to "user:password" to require a login.
BASIC_AUTH=

# Icon search backend (only change it if you self-host Iconify).
# ICONIFY_API=https://api.iconify.design
